      "path": "TutorialExploreUI/TutorialSteps/Explanation_06/TutorialGuideBackground/Text (TMP)"
    },
    {
      "id": "scene.TutorialExploreScene.TutorialExploreUI.TutorialSteps.Explanation_06.TutorialGuideBackground.TutorialContinueHint",
