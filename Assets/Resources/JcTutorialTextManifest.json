      "path": "TutorialExploreUI/TutorialSteps/Explanation_05/TutorialGuideBackground/Text (TMP)"
    },
    {
      "id": "scene.TutorialExploreScene.TutorialExploreUI.TutorialSteps.Explanation_05.TutorialGuideBackground.TutorialContinueHint",
      "text": "안내한 조작을 완료하면 계속합니다.",
      "scene": "TutorialExploreScene",
      "path": "TutorialExploreUI/TutorialSteps/Explanation_05/TutorialGuideBackground/TutorialContinueHint"
    },
    {
      "id": "scene.TutorialExploreScene.TutorialExploreUI.TutorialSteps.Explanation_05.TutorialGuideBackground.TutorialPreviewLabel",
