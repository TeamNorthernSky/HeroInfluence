  m_Script: {fileID: 11500000, guid: 51255f5ee3c890845866cc78b6aebfc3, type: 3}
  m_Name: WorldHeroDialogueDataTable
  m_EditorClassIdentifier: 
  DataList:
  - hero_id: 0
    out_of_action_range_dialogue: "\uC544\uC9C1 \uAC70\uAE30\uAE4C\uC9C0 \uAC08 \uC218
      \uC5C6\uB2E4\uB124"
    funds_acquired_dialogue: "\uC774 \uB3C8\uC73C\uB85C \uB354 \uD798\uB4E0 \uC0AC\uB78C\uB4E4\uC744
      \uB3C4\uC640\uC918\uC57C \uD558\uB294 \uBC95"
    crystal_acquired_dialogue: "\uC218\uC815\uC73C\uB85C \uCF54\uC5B4\uB97C \uAC15\uD654\uD558\uC790\uACE0"
    medal_acquired_dialogue: "\uC774\uAC78\uB85C \uC6B0\uB9B0 \uB354\uC6B1\uB354
      \uAC15\uD574\uC9C8 \uC218 \uC788\uC9C0"
    materials_acquired_dialogue: "\uBB34\uB108\uC9C4 \uD611\uD68C\uC5D0\uB294 \uC790\uC7AC\uB9CC\uD55C
      \uAC8C \uC5C6\uC9C0"
    gate_opened_dialogue: "\uC774\uC81C \uB2E4\uC74C \uAD6C\uC5ED\uC5D0 \uAC00\uC11C
      \uC2DC\uBBFC\uB4E4\uC744 \uB3C4\uC640\uC8FC\uC790\uACE0"
    idle_5_seconds_dialogue: "\uD73C\uB96D\uD55C \uC791\uC804\uC744 \uAE30\uB2E4\uB9AC\uACA0\uB2E4"
    base_arrival_dialogue: "\uC5EC\uAE30\uC11C \uC815\uBE44 \uC880 \uD558\uC790\uACE0"
  - hero_id: 1
    out_of_action_range_dialogue: "\uADF8\uCABD\uAE4C\uC9C0\uB294... \uBB34\uB9AC\uC5D0\uC694\u2026."
    funds_acquired_dialogue: "\uC800\uD76C\uAC00... \uC774 \uB3C8\uC744... \uC8FC\uC6CC\uB3C4
      \uB418\uB294... \uAC74\uAC00\uC694\u2026?"
    crystal_acquired_dialogue: "\uC218\uC815\uC73C\uB85C \uCF54\uC5B4\uB97C \uB9CC\uB4E4
      \uC218\uB3C4 \uC788\uC5B4\uC694"
    medal_acquired_dialogue: "\uBA54\uB2EC\uB85C \uB354 \uAC15\uD574\uC9C8 \uC218
      \uC788\uACA0\uC5B4\uC694!"
    materials_acquired_dialogue: "\uC774\uAC78\uB85C \uB0A0\uC544\uAC04 \uD611\uD68C
      \uAC04\uD310\uC744 \uB2E4\uC2DC \uC138\uC6B8 \uC218 \uC788\uACA0\uC5B4\uC694"
    gate_opened_dialogue: "\uC557! \uB2E4\uC74C \uAD6C\uC5ED\uC758 \uAC8C\uC774\uD2B8\uAC00
      \uC5F4\uB838\uC5B4\uC694!"
    idle_5_seconds_dialogue: "\uD611\uD68C\uC7A5\uB2D8? \uC800\uD76C \uC5B8\uC81C\uAE4C\uC9C0
      \uAE30\uB2E4\uB9B4\uAE4C\uC694?"
    base_arrival_dialogue: "\uC800\uD76C \uC815\uBE44 \uC880 \uD574\uC694"
  - hero_id: 2
    out_of_action_range_dialogue: "\uAC70\uAE30\uAE4C\uC9C4 \uD798\uB4E0\uB370~"
    funds_acquired_dialogue: "\uC774\uAC78\uB85C \uBB58\uD574\uC57C \uC18C\uBB38\uC774
      \uB0A0\uAE4C~"
    crystal_acquired_dialogue: "\uD611\uD68C\uC5D0\uC11C \uCF54\uC5B4 \uC880 \uAC15\uD654\uD560\uAE4C?"
    medal_acquired_dialogue: "\uC774\uAC78\uB85C \uB0B4 \uD50C\uB808\uC5B4 \uBD04
      \uC880 \uAC15\uD654\uD574\uC918"
    materials_acquired_dialogue: "\uB0B4 \uC798\uBABB\uC740 \uC544\uB2C8\uC9C0\uB9CC
      \uADF8\uB798\uB3C4 \uD611\uD68C\uB294 \uC138\uC6CC\uC57C\uC9C0"
    gate_opened_dialogue: "\uAC8C\uC774\uD2B8\uAC00 \uC5F4\uB838\uB124"
    idle_5_seconds_dialogue: "\uC5B8\uC81C\uAE4C\uC9C0 \uC0DD\uAC01\uD560\uAEBC\uC57C"
    base_arrival_dialogue: "\uD504\uB9AC\uC998 \uC775\uC2A4\uD50C\uB85C\uC804 \uC880
      \uC5F0\uC2B5\uD560\uAE4C?"
  - hero_id: 3
    out_of_action_range_dialogue: "\uAC70\uAE34 \uD798\uB4E4\uC5B4\uC11C \uBABB \uAC00!"
    funds_acquired_dialogue: "\uCEAC\uD558\uD56B! \uD611\uD68C\uC7A5! \uC774\uAC78\uB85C
      \uD611\uD68C \uAC04\uC2DD\uC774\uB098 \uC0AC\uC790!"
    crystal_acquired_dialogue: "\uCF54\uC5B4\uB97C \uAC15\uD654\uD574\uC11C \uBE4C\uB7F0\uB4E4\uC744
      \uB354 \uC7A1\uC790\uACE0"
    medal_acquired_dialogue: "\uC5EC\uAE30\uC11C \uB0B4 \uB2A5\uB825\uC744 \uB354
      \uD0A4\uC6B0\uBA74 \uBE4C\uB7F0\uC774\uB4E0 \uD611\uD68C\uB4E0 \uB2E4\u2026."
    materials_acquired_dialogue: "\uD06C\uD06C\uD06C \uC774\uAC78\uB85C \uD611\uD68C
      2\uBC88\uC740 \uB354 \uB0A0\uB9B4 \uC218 \uC788\uACA0\uB2E4"
    gate_opened_dialogue: "\uB2E4\uC74C \uAD6C\uC5ED\uC5D0\uB3C4 \uBD80\uC2E4 \uAC70
      \uC788\uB098 \uBCF4\uB7EC\uAC00\uC790"
    idle_5_seconds_dialogue: "\uD611\uD68C\uC7A5? \uC790\uB9AC\uC5D0 \uC5C6\uB098?"
    base_arrival_dialogue: "\uC544\u314F\u314F\u314F \uD798\uB4E4\uC5B4 \uC880 \uC26C\uC790"
