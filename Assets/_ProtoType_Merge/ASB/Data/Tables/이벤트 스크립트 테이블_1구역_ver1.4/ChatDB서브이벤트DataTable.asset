    Next_Chat_ID: 1100050
    Branch_Group_ID: 0
  - Chat_ID: 1100050
    Chat_Type: 0
    Char_Name: "\uD3B8\uC758\uC810 \uBE4C\uB7F0"
    Char_Profile: 
    Message_Text: "\uD558\uC9C0\uB9CC \uD611\uD68C\uB294 \uC81C \uC774\uC0C1\uC744
      \uAC70\uC808\uD588\uC2B5\uB2C8\uB2E4. \uBAA8\uB4E0 \uC9C4\uC0C1\uC744 \uAD6C\uCD95\uD558\uACA0\uB2E4\uB294
