  - Chat_ID: 1100060
    Chat_Type: 0
    Char_Name: "\uB8E8\uBBF8\uB098"
    Char_Profile: 
    Message_Text: "\uD611\uD68C\uAC00 \uC758\uC678\uB85C \uC815\uC0C1\uC801\uC778
