  - Chat_ID: 1100040
    Chat_Type: 0
    Char_Name: "\uD3B8\uC758\uC810 \uBE4C\uB7F0"
    Char_Profile: 
    Message_Text: "\uD788\uC5B4\uB85C? \uC81C\uAC00 \uB418\uACE0 \uC2F6\uC5C8\uB358
