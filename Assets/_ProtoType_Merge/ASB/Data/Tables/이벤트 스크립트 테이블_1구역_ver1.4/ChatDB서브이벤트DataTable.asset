    IMG_Res: 
    Next_Chat_ID: 1100070
    Branch_Group_ID: 0
  - Chat_ID: 1100070
    Chat_Type: 0
    Char_Name: "\uD3B8\uC758\uC810 \uBE4C\uB7F0"
