    Next_Chat_ID: 1050140
    Branch_Group_ID: 0
  - Chat_ID: 1050140
    Chat_Type: 1
    Char_Name: 
    Char_Profile: 
    Message_Text: "\uC815\uBCF4\uC758 \uB300\uAC00\uB97C \uBA85\uD655\uD788 \uD55C
