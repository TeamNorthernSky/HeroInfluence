    Next_Chat_ID: 1050120
    Branch_Group_ID: 0
  - Chat_ID: 1050120
    Chat_Type: 0
    Char_Name: "\uAC81\uBA39\uC740 \uC18C\uB140"
    Char_Profile: 
    Message_Text: "\uC81C\u2026 \uC81C \uC800\uAE08\uD1B5 \uB4DC\uB9B4\uAC8C\uC694.
