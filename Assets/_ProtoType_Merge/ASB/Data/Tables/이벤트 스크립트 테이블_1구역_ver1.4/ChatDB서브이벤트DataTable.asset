    IMG_Res: 
    Next_Chat_ID: 1050130
    Branch_Group_ID: 0
  - Chat_ID: 1050130
    Chat_Type: 0
    Char_Name: "\uB8E8\uBBF8\uB098"
    Char_Profile: 
    Message_Text: "\uAD00\uB9AC\uC790. \uBC29\uAE08 \uC5B4\uB9B0\uC560 \uC0C1\uB300\uB85C
