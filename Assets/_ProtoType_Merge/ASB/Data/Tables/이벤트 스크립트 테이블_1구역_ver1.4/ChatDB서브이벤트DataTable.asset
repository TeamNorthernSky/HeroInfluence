    Branch_Group_ID: 0
  - Chat_ID: 1100030
    Chat_Type: 1
    Char_Name: 
    Char_Profile: 
    Message_Text: "\uC6B0\uB9B0 \uD788\uC5B4\uB85C\uB2E4."
