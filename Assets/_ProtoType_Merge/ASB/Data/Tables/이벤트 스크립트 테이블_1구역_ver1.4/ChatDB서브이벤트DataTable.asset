  - Chat_ID: 1050110
    Chat_Type: 1
    Char_Name: 
    Char_Profile: 
    Message_Text: "\uB3C4\uC640\uC8FC\uAE34 \uD560 \uAC74\uB370, \uC704\uD5D8\uD55C
