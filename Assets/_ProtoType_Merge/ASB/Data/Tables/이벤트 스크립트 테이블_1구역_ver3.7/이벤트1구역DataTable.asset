  m_Script: {fileID: 11500000, guid: 37358a4ac35a817498f30fb75866f5bc, type: 3}
  m_Name: "\uC774\uBCA4\uD2B81\uAD6C\uC5EDDataTable"
  m_EditorClassIdentifier: 
  DataList:
  - Field_02: "\uC784\uBB34 \uBE0C\uB9AC\uD551"
    Field_03: 102XXXX
    "\uC81C\uBAA9": "\uD759\uB0B4\uAC00 \uACE0\uC18C\uD558\uB2E4"
    "\uC18C\uAC1C": "\uD611\uD68C\uAC00 \uBC15\uC0B4\uB098\uACE0, \uB2F5 \uC5C6\uB294
      \uD30C\uD2F0\uB97C \uC774\uB04C\uACE0 \uC624\uB85C\uB77C\uB97C \uC810\uB839\uD55C
      \uBE4C\uB7F0 \uC5F0\uD569\uC744 \uBAB0\uC544\uB0B4\uC57C \uD558\uB294 \uC0C1\uD669
      \uACF5\uC720. \n\uADF8 \uCCAB \uB2E8\uACC4\uB85C \uACF5\uAD6C\uC0C1\uC744 \uD0C8\uD658\uD558\uC790."
    "\uBE44\uACE0": 
  - Field_02: "\uBA54\uC778\uD018\uC2A4\uD2B8"
    Field_03: 111XXXX
    "\uC81C\uBAA9": "\uBA54\uC778\uD018\uC2A4\uD2B81-1_\uC9C4\uC785"
    "\uC18C\uAC1C": "\uC120\uBC1C\uB300\uC758 \uD754\uC801\uC744 \uCC3E\uB358 \uD788\uC5B4\uB85C\uB4E4\uC774
      \uD611\uD68C \uC794\uD574 \uADFC\uCC98\uC5D0\uC11C \uC0C1\uC790\uB97C \uB4A4\uC9C0\uB294
      \uC57D\uD0C8\uAFBC \uBB34\uB9AC\uB97C \uBC1C\uACAC\uD55C\uB2E4.\n\uC57D\uD0C8\uAFBC\uB4E4\uC740
      \uBE4C\uB7F0 \uC5F0\uD569 \uC18C\uC18D\uC774 \uC544\uB2C8\uB77C, \uBE4C\uB7F0
      \uC5F0\uD569\uC5D0 \uC798 \uBCF4\uC774\uB824\uACE0 \uD611\uD68C \uBB3C\uC790\uB97C
      \uD138\uC5B4 \uBC14\uCE58\uB824\uB294 \uCC28\uAE30 \uBE4C\uB7F0 \uC9C0\uB9DD\uC0DD\uB4E4\uC774\uB2E4.\n\uD788\uC5B4\uB85C\uB4E4\uC740
      \uD611\uD68C \uBB3C\uC790\uB97C \uC9C0\uD0A4\uACE0 \uC120\uBC1C\uB300 \uC815\uBCF4\uB97C
      \uCE90\uB0B4\uAE30 \uC704\uD574 \uC804\uD22C\uC5D0 \uB4E4\uC5B4\uAC04\uB2E4."
    "\uBE44\uACE0": "\uD2B9\uC815 \uAD6C\uC5ED \uB3C4\uB2EC \uC2DC \uD65C\uC131\uD654
      / \uBA54\uC778\uD018\uC2A4\uD2B81-2 \uD074\uB9AC\uC5B4 \uC2DC \uC9C4\uD589
      \uBD88\uAC00"
  - Field_02: 
    Field_03: 112XXXX
    "\uC81C\uBAA9": "\uBA54\uC778\uD018\uC2A4\uD2B81-1_\uC2B9\uB9AC"
    "\uC18C\uAC1C": "\uC57D\uD0C8\uAFBC\uB4E4\uC744 \uC81C\uC555\uD55C \uB4A4, \uB0A8\uC740
      \uC57D\uD0C8\uAFBC\uC5D0\uAC8C\uC11C \uBE4C\uB7F0 \uC5F0\uD569 \uC120\uBC1C\uB300\uAC00
      \uACF5\uAD6C\uC0C1\uC744 \uC804\uCD08\uAE30\uC9C0\uB85C \uC4F4\uB2E4\uB294
      \uC815\uBCF4\uB97C \uC5BB\uB294\uB2E4.\n\uBD84\uAE30 \uC120\uD0DD\uC5D0 \uB530\uB77C
      \uB8E8\uBBF8\uB098\uAC00 \uACFC\uACA9\uD55C \uC704\uD611\uC73C\uB85C '\uB098\uB77D'
      \uC774\uBBF8\uC9C0\uB97C \uC5BB\uAC70\uB098, \uB124\uCF54\uBC0D\uC758 \uBD88\uC6B4
      \uC0AC\uACE0\uB85C \uC57D\uD0C8\uAFBC\uACFC \uC8FC\uBCC0 \uAC74\uBB3C\uC774
      \uD568\uAED8 \uC815\uB9AC\uB41C\uB2E4.\n\uB8E8\uBBF8\uB098\uB97C \uC9C1\uC811
      \uC81C\uC9C0\uD55C \uACBD\uC6B0 \uACF5\uAD6C\uC0C1\uC774 \uC120\uBC1C\uB300
      \uAC70\uC810\uC774\uB77C\uB294 \uC0AC\uC2E4\uC744 \uD655\uC778\uD558\uACE0,
      \uB124\uCF54\uBC0D\uC5D0\uAC8C \uB9E1\uAE34 \uACBD\uC6B0 \uC57D\uD0C8\uAFBC\uC758
      \uB178\uD2B8\uC5D0\uC11C \uACF5\uAD6C\uC0C1 \uC704\uCE58\uAE4C\uC9C0 \uD30C\uC545\uD55C\uB2E4.\n\uD788\uC5B4\uB85C\uB4E4\uC740
      \uD655\uC778\uD55C \uC815\uBCF4\uB97C \uBC14\uD0D5\uC73C\uB85C \uB2E4\uC74C
      \uBAA9\uD45C\uB97C \uC815\uD55C\uB2E4."
    "\uBE44\uACE0": "\uD2B9\uC815 \uAD6C\uC5ED \uB3C4\uB2EC \uC2DC \uD65C\uC131\uD654
      / \uBA54\uC778\uD018\uC2A4\uD2B81-2 \uD074\uB9AC\uC5B4 \uC2DC \uC9C4\uD589
      \uBD88\uAC00"
  - Field_02: 
    Field_03: 113XXXX
    "\uC81C\uBAA9": "\uBA54\uC778\uD018\uC2A4\uD2B81-1_\uD328\uBC30"
    "\uC18C\uAC1C": "\uD788\uC5B4\uB85C\uB4E4\uC774 \uBCC0\uBCC0\uCC2E\uC740 \uC57D\uD0C8\uAFBC\uB4E4\uC5D0\uAC8C
      \uD328\uBC30\uD55C\uB2E4.\n\uAD00\uB9AC\uC790\uB294 \uC5F0\uB9C9\uACFC \uB4DC\uB860\uC73C\uB85C
      \uC2DC\uC120\uC744 \uB3CC\uB9B0 \uB4A4 \uAE30\uC808\uD55C \uD788\uC5B4\uB85C\uB4E4\uC744
      \uC218\uC2B5\uD574 \uD611\uD68C\uB85C \uBCF5\uADC0\uD55C\uB2E4.\n\uD328\uBC30
      \uC804\uC801 \uD50C\uB798\uADF8\uAC00 \uB0A8\uC544 \uC774\uD6C4 \uAC19\uC740
      \uC870\uC6B0 \uC7AC\uC804\uD22C \uD750\uB984\uC73C\uB85C \uC774\uC5B4\uC9C4\uB2E4."
    "\uBE44\uACE0": "\uD2B9\uC815 \uAD6C\uC5ED \uB3C4\uB2EC \uC2DC \uD65C\uC131\uD654
      / \uBA54\uC778\uD018\uC2A4\uD2B81-2 \uD074\uB9AC\uC5B4 \uC2DC \uC9C4\uD589
      \uBD88\uAC00"
  - Field_02: 
    Field_03: 114XXXX
    "\uC81C\uBAA9": "\uBA54\uC778\uD018\uC2A4\uD2B81-1_\uC7AC\uC804\uD22C"
    "\uC18C\uAC1C": "\uC774\uC804\uC5D0 \uD788\uC5B4\uB85C\uB4E4\uC744 \uC774\uACBC\uB358
      \uC57D\uD0C8\uAFBC\uB4E4\uC774 \uB2E4\uC2DC \uB098\uD0C0\uB09C \uD788\uC5B4\uB85C\uB4E4\uC744
      \uB3C4\uBC1C\uD55C\uB2E4.\n\uD788\uC5B4\uB85C\uB4E4\uC740 \uC774\uBC88\uC5D0\uB294
      \uBC18\uB4DC\uC2DC \uC4F0\uB7EC\uB728\uB9AC\uACA0\uB2E4\uBA70 \uC9E7\uC740
      \uB300\uD654 \uD6C4 \uACE7\uBC14\uB85C \uC804\uD22C\uC5D0 \uC7AC\uC9C4\uC785\uD55C\uB2E4."
    "\uBE44\uACE0": "\uD2B9\uC815 \uAD6C\uC5ED \uB3C4\uB2EC \uC2DC \uD65C\uC131\uD654
      / \uBA54\uC778\uD018\uC2A4\uD2B81-2 \uD074\uB9AC\uC5B4 \uC2DC \uC9C4\uD589
      \uBD88\uAC00"
  - Field_02: 
    Field_03: 115XXXX
    "\uC81C\uBAA9": "\uBA54\uC778\uD018\uC2A4\uD2B81-2_\uC9C4\uC785"
    "\uC18C\uAC1C": "\uC120\uBC1C\uB300\uC758 \uD754\uC801\uC744 \uCC3E\uB358 \uD788\uC5B4\uB85C\uB4E4\uC740
      \uBE4C\uB7F0\uB4E4\uC5D0\uAC8C \uB458\uB7EC\uC2F8\uC778 \uC18C\uB140\uB97C
      \uB9CC\uB09C\uB2E4.\n\uC18C\uB140\uB294 \uACF5\uAD6C\uC0C1 \uADFC\uCC98\uC5D0\uC11C
      \uC0AC\uB77C\uC9C4 \uC624\uBE60\uB97C \uCC3E\uACE0 \uC788\uC5C8\uACE0, \uBE4C\uB7F0\uB4E4\uC758
      \uC704\uD611\uC5D0\uB3C4 \uBB3C\uB7EC\uC11C\uC9C0 \uC54A\uB294\uB2E4.\n\uD788\uC5B4\uB85C\uB4E4\uC740
      \uC18C\uB140\uB97C \uBCF4\uD638\uD558\uACE0 \uC624\uBE60\uC758 \uD589\uBC29\uC744
      \uBB3B\uAE30 \uC704\uD574 \uBE4C\uB7F0\uB4E4\uACFC \uC804\uD22C\uC5D0 \uB4E4\uC5B4\uAC04\uB2E4."
    "\uBE44\uACE0": "\uD2B9\uC815 \uAD6C\uC5ED \uB3C4\uB2EC \uC2DC \uD65C\uC131\uD654
      / \uBA54\uC778\uD018\uC2A4\uD2B81-1 \uD074\uB9AC\uC5B4 \uC2DC \uC9C4\uD589
      \uBD88\uAC00"
  - Field_02: 
    Field_03: 116XXXX
    "\uC81C\uBAA9": "\uBA54\uC778\uD018\uC2A4\uD2B81-2_\uACB0\uB860"
    "\uC18C\uAC1C": "\uBE4C\uB7F0\uB4E4\uC744 \uC81C\uC555\uD55C \uB4A4, \uC18C\uB140\uC758
      \uC624\uBE60\uAC00 \uB0A9\uCE58\uB41C \uAC83\uC774 \uC544\uB2C8\uB77C \uBE4C\uB7F0
      \uC5F0\uD569\uC5D0 \uB4E4\uC5B4\uAC00\uB824 \uACF5\uAD6C\uC0C1 \uCABD\uC73C\uB85C
      \uD5A5\uD588\uB2E4\uB294 \uB2E8\uC11C\uB97C \uC5BB\uB294\uB2E4.\n\uC18C\uB140\uB294
      \uD55C\uC2EC\uD55C \uC624\uBE60\uB77C\uB3C4 \uAC00\uC871\uC774\uB77C\uBA70
      \uC9C1\uC811 \uCC3E\uC73C\uB824 \uD558\uACE0, \uD788\uC5B4\uB85C\uB4E4\uC740
      \uADF8\uB140\uB97C \uD63C\uC790 \uBCF4\uB0BC \uC218 \uC5C6\uC5B4 \uB3D9\uD589\uD558\uAE30\uB85C
      \uD55C\uB2E4.\n\uACB0\uAD6D \uD30C\uD2F0\uB294 \uC18C\uB140\uC640 \uD568\uAED8
      \uACF5\uAD6C\uC0C1\uC73C\uB85C \uC774\uC5B4\uC9C0\uB294 \uAE38\uBAA9\uC744
      \uC870\uC0AC\uD558\uAC8C \uB41C\uB2E4."
    "\uBE44\uACE0": "\uD2B9\uC815 \uAD6C\uC5ED \uB3C4\uB2EC \uC2DC \uD65C\uC131\uD654
      / \uBA54\uC778\uD018\uC2A4\uD2B81-1 \uD074\uB9AC\uC5B4 \uC2DC \uC9C4\uD589
      \uBD88\uAC00"
  - Field_02: 
    Field_03: 117XXXX
    "\uC81C\uBAA9": "\uBA54\uC778\uD018\uC2A4\uD2B81-2_\uD328\uBC30"
    "\uC18C\uAC1C": "\uD788\uC5B4\uB85C\uB4E4\uC774 \uBE4C\uB7F0\uB4E4\uC5D0\uAC8C
      \uD328\uBC30\uD55C \uC0AC\uC774, \uC18C\uB140\uB294 \uC624\uBE60\uB97C \uCC3E\uACA0\uB2E4\uBA70
      \uACE8\uBAA9 \uB108\uBA38\uB85C \uC0AC\uB77C\uC9C4\uB2E4.\n\uAD00\uB9AC\uC790\uB294
      \uC5F0\uB9C9\uACFC \uB4DC\uB860\uC73C\uB85C \uC4F0\uB7EC\uC9C4 \uD788\uC5B4\uB85C\uB4E4\uC744
      \uC218\uC2B5\uD574 \uD611\uD68C\uB85C \uBCF5\uADC0\uD55C\uB2E4.\n\uD328\uBC30
      \uC804\uC801 \uD50C\uB798\uADF8\uAC00 \uB0A8\uC544 \uC774\uD6C4 \uAC19\uC740
      \uC870\uC6B0 \uC7AC\uC804\uD22C \uD750\uB984\uC73C\uB85C \uC774\uC5B4\uC9C4\uB2E4."
    "\uBE44\uACE0": "\uD2B9\uC815 \uAD6C\uC5ED \uB3C4\uB2EC \uC2DC \uD65C\uC131\uD654
      / \uBA54\uC778\uD018\uC2A4\uD2B81-1 \uD074\uB9AC\uC5B4 \uC2DC \uC9C4\uD589
      \uBD88\uAC00"
  - Field_02: 
    Field_03: 118XXXX
    "\uC81C\uBAA9": "\uBA54\uC778\uD018\uC2A4\uD2B81-2_\uC7AC\uC804\uD22C"
    "\uC18C\uAC1C": "\uB3CC\uACE0 \uB3CC\uC544 \uAC19\uC740 \uACE8\uBAA9\uC73C\uB85C
      \uB3CC\uC544\uC628 \uC18C\uB140\uC640 \uBE4C\uB7F0\uB4E4\uC744 \uB2E4\uC2DC
      \uB9CC\uB09C\uB2E4.\n\uD788\uC5B4\uB85C\uB4E4\uC740 \uC774\uBC88\uC5D0\uB294
      \uC18C\uB140\uB97C \uC9C0\uD0A4\uACE0 \uC624\uBE60\uC758 \uD589\uBC29\uC744
      \uC54C\uC544\uB0B4\uACA0\uB2E4\uBA70 \uACE7\uBC14\uB85C \uC804\uD22C\uC5D0
      \uC7AC\uC9C4\uC785\uD55C\uB2E4."
    "\uBE44\uACE0": "\uD2B9\uC815 \uAD6C\uC5ED \uB3C4\uB2EC \uC2DC \uD65C\uC131\uD654
      / \uBA54\uC778\uD018\uC2A4\uD2B81-1 \uD074\uB9AC\uC5B4 \uC2DC \uC9C4\uD589
      \uBD88\uAC00"
  - Field_02: 
    Field_03: 119XXXX
    "\uC81C\uBAA9": "\uBA54\uC778\uD018\uC2A4\uD2B82-1_\uC9C4\uC785"
    "\uC18C\uAC1C": "\uACF5\uAD6C\uC0C1\uC73C\uB85C \uD5A5\uD558\uB294 \uAE38\uBAA9
      \uC911 \uD558\uB098, \uC5EC\uAE30\uC5D4 \uBE4C\uB7F0\uB4E4\uC774 \uD788\uC5B4\uB85C\uB4E4\uC774
      \uC624\uB294\uC904\uB3C4 \uBAA8\uB974\uACE0 \uAD34\uB2F4 \uC0BC\uB9E4\uACBD\uC5D0
      \uBE60\uC838\uC788\uB2E4.\n\uC694\uC9C0\uB294 \uD3B8\uC758\uC810 \uC9C4\uC0C1\uB9CC
      \uB178\uB9AC\uB294 \uD3B8\uC758\uC810 \uBE4C\uB7F0\uC774 \uC774\uACF3\uC5D0
      \uD310\uCE58\uACE0 \uC788\uB2E4\uB294 \uAC83.\n\uD3C9\uC18C \uB0A8\uC758 \uBB3C\uAC74\uC744
      \uBE7C\uC557\uAE30\uB9CC \uD558\uB294 \uBE4C\uB7F0\uB4E4\uC774 \uD3B8\uC758\uC810
      \uC9C4\uC0C1\uC774 \uC544\uB2C8\uC5C8\uB358 \uC801\uC774 \uC5C6\uC5C8\uAE30\uC5D0,
      \uADF8\uB4E4\uC740 \uAE34\uC7A5\uD558\uBA70 \uB300\uD654\uC5D0 \uAE4A\uC774
      \uBAB0\uC785\uD55C\uB2E4.\n- \uC804\uD22C : \uAD34\uB2F4 \uC0BC\uB9E4\uACBD\uC5D0
      \uBE60\uC9C4 \uBE4C\uB7F0\uB4E4\uC744 \uAE09\uC2B5\uD55C\uB2E4. \uC804\uD22C
      \uBC1C\uC0DD.\n- \uB300\uD654 : \uBE14\uB799 \uBD88\uB9BF\uC774 \uBA3C\uC800
      \uB098\uC11C\uBA70.  \uBE4C\uB7F0\uB4E4\uC758 \uB300\uD654\uC5D0 \uB07C\uC5B4\uB4E0\uB2E4.\n[\uD2B9\uC218
      \uD50C\uB798\uADF8]\n\uC11C\uBE0C \uD018\uC2A4\uD2B8 \uD3B8\uC758\uC810 \uBE4C\uB7F0
      \uD074\uB9AC\uC5B4 = \uD3B8\uC758\uC810 \uBE4C\uB7F0\uC744 \uC774\uBBF8 \uC7A1\uC558\uB2E4\uBA74
      \uADF8\uB4E4\uC5D0\uAC8C \uC774 \uC18C\uC2DD\uC744 \uD758\uB9B0\uB2E4. \uADF8\uB4E4\uC740
      \uC774\uC81C \uBB34\uC11C\uC6B8 \uAC8C \uC5C6\uB2E4\uBA70 \uC790\uB791\uC2A4\uB7FD\uAC8C
      \uADFC\uCC98\uC758 \uD3B8\uC758\uC810\uC744 \uD138\uC5B4\uBA39\uC744 \uC0DD\uAC01\uC73C\uB85C
      \uC790\uB9AC\uB97C \uBE44\uC6B4\uB2E4. \uADF8\uB7EC\uB098 \uD574\uB2F9 \uD3B8\uC758\uC810\uC5D4
      \uD3B8\uC758\uC810 \uBE4C\uB7F0\uC774 \uC54C\uBC14\uB85C \uC77C\uD558\uACE0
      \uC788\uC5C8\uACE0, \uACB0\uAD6D \uADF8\uB4E4\uC740 \uB3CC\uC544\uC624\uC9C0
      \uBABB\uD55C\uB2E4.\n\n\uBA54\uC778\uD018\uC2A4\uD2B81-2 \uD074\uB9AC\uC5B4
      = \uC18C\uB140\uAC00 \uBE4C\uB7F0\uB4E4\uC5D0\uAC8C \uC811\uADFC\uD574 \uB2E4\uC9DC\uACE0\uC9DC,
      \uC624\uBE60\uC758 \uD589\uBC29\uC744 \uBB3B\uB294\uB2E4.\n\uBE4C\uB7F0\uB4E4\uC774
      \uB2F9\uD669\uD558\uC5EC \uADF8\uB140\uB97C \uACF5\uACA9\uD558\uB824 \uD558\uC790,
      \uD788\uC5B4\uB85C\uB4E4\uC774 \uADF8\uB140\uB97C \uBCF4\uD638\uD558\uAE30
      \uC704\uD574 \uC2F8\uC6B4\uB2E4."
    "\uBE44\uACE0": "\uD2B9\uC815 \uAD6C\uC5ED \uB3C4\uB2EC \uC2DC \uD65C\uC131\uD654
      / \uBA54\uC778\uD018\uC2A4\uD2B82-2, \uBA54\uC778\uD018\uC2A4\uD2B82-3 \uD074\uB9AC\uC5B4
      \uC2DC \uC9C4\uD589 \uBD88\uAC00"
  - Field_02: 
    Field_03: 120XXXX
    "\uC81C\uBAA9": "\uBA54\uC778\uD018\uC2A4\uD2B82-1_\uACB0\uB860"
    "\uC18C\uAC1C": "\uAE38\uBAA9\uC744 \uB3CC\uD30C\uD55C \uD788\uC5B4\uB85C\uB4E4\uC740
      \uACF5\uAD6C\uC0C1 \uBCF4\uAE09 \uC9C0\uB3C4\uC5D0\uC11C \uC778\uC9C8 \uC791\uC5C5\uC7A5\uACFC
      \uADFC\uBB34 \uC778\uC6D0\uC744 \uD655\uC778\uD55C\uB2E4.\n\uACF5\uAD6C\uC0C1\uC758
      \uC704\uCE58\uB294 \uBA54\uC778\uD018\uC2A4\uD2B81\uC5D0\uC11C \uC774\uBBF8
      \uD30C\uC545\uD588\uC73C\uBA70, \uC774 \uACBD\uB85C\uC5D0\uC11C\uB294 \uC778\uC9C8\uC758
      \uC874\uC7AC\uC640 \uC704\uCE58\uB97C \uCD94\uAC00\uB85C \uD655\uC815\uD55C\uB2E4.\n\n[\uD2B9\uC218
      \uD50C\uB798\uADF8]\n\uBA54\uC778\uD018\uC2A4\uD2B81-2 \uD074\uB9AC\uC5B4 =
      \uC18C\uB140\uB294 \uC624\uBE60\uAC00 \uC790\uBC1C\uC801\uC73C\uB85C \uBE4C\uB7F0
      \uC5F0\uD569\uC5D0 \uB4E4\uC5B4\uAC14\uB2E4\uAC00 \uBC84\uB824\uC84C\uB2E4\uB294
      \uC0AC\uC2E4\uC744 \uB4E3\uACE0 \uACF5\uAD6C\uC0C1\uC73C\uB85C \uD5A5\uD55C\uB2E4."
    "\uBE44\uACE0": "\uD2B9\uC815 \uAD6C\uC5ED \uB3C4\uB2EC \uC2DC \uD65C\uC131\uD654
      / \uBA54\uC778\uD018\uC2A4\uD2B82-2, \uBA54\uC778\uD018\uC2A4\uD2B82-3 \uD074\uB9AC\uC5B4
      \uC2DC \uC9C4\uD589 \uBD88\uAC00"
  - Field_02: 
    Field_03: 121XXXX
    "\uC81C\uBAA9": "\uBA54\uC778\uD018\uC2A4\uD2B82-1_\uD328\uBC30"
    "\uC18C\uAC1C": "\uBE4C\uB7F0\uC5D0\uAC8C \uD328\uBC30\uD55C \uD788\uC5B4\uB85C\uB4E4\uC744
      \uC218\uC2B5\uD558\uACE0 \uD611\uD68C\uB85C \uBCF5\uADC0\uD55C\uB2E4.\n\uC628\uAC16
      \uD3FC\uC740 \uB2E4 \uC7A1\uACE0 \uD328\uBC30\uD55C \uC0AC\uC2E4\uC5D0 \uBD80\uB044\uB7EC\uC6CC\uD558\uB294
      \uAD00\uB9AC\uC790"
    "\uBE44\uACE0": "\uD2B9\uC815 \uAD6C\uC5ED \uB3C4\uB2EC \uC2DC \uD65C\uC131\uD654
      / \uBA54\uC778\uD018\uC2A4\uD2B82-2, \uBA54\uC778\uD018\uC2A4\uD2B82-3 \uD074\uB9AC\uC5B4
      \uC2DC \uC9C4\uD589 \uBD88\uAC00"
  - Field_02: 
    Field_03: 122XXXX
    "\uC81C\uBAA9": "\uBA54\uC778\uD018\uC2A4\uD2B82-1_\uC7AC\uC804\uD22C"
    "\uC18C\uAC1C": "\uBE4C\uB7F0\uB4E4\uC740 \uD328\uBC30\uD55C \uC8FC\uC81C\uC5D0
      \uB610 \uC654\uB290\uB0D0\uBA70 \uB2EC\uB824\uB4E0\uB2E4."
    "\uBE44\uACE0": "\uD2B9\uC815 \uAD6C\uC5ED \uB3C4\uB2EC \uC2DC \uD65C\uC131\uD654
      / \uBA54\uC778\uD018\uC2A4\uD2B82-2, \uBA54\uC778\uD018\uC2A4\uD2B82-3 \uD074\uB9AC\uC5B4
      \uC2DC \uC9C4\uD589 \uBD88\uAC00"
  - Field_02: 
    Field_03: 123XXXX
    "\uC81C\uBAA9": "\uBA54\uC778\uD018\uC2A4\uD2B82-2_\uC9C4\uC785"
    "\uC18C\uAC1C": "\uC774\uACF3\uC740 \uAD50\uCC28\uB85C\uB85C \uD788\uC5B4\uB85C
      \uD611\uD68C\uB97C \uC810\uB839\uD558\uAE30 \uC704\uD574 \uBE4C\uB7F0 \uC5F0\uD569
      \uC120\uBC1C\uB300\uAC00 \uC138\uC6B4 \uAC80\uBB38\uC18C\uB2E4.\n\uADF8\uACF3\uC5D0\uC11C
      \uD788\uC5B4\uB85C\uB4E4\uC740 \uC775\uC219\uD55C \uC5BC\uAD74\uC744 \uB9CC\uB098\uAC8C
      \uB418\uB294\uB370...\n\n[\uD2B9\uC218 \uD50C\uB798\uADF8]\n\uBA54\uC778\uD018\uC2A4\uD2B81-1
      \uB8E8\uBBF8\uB098 \uB098\uB77D = \uB2F9\uC2E0\uC774 \uACA9\uD1F4\uD55C \uC57D\uD0C8\uAFBC\uB4E4\uC744
      \uB9CC\uB09C\uB2E4. \uADF8\uB294 \uD788\uC5B4\uB85C\uB4E4, \uD2B9\uD788 \uB8E8\uBBF8\uB098\uB97C
      \uC54C\uC544\uBCF4\uACE0 \uBE4C\uB7F0\uB4E4\uC5D0\uAC8C \uC54C\uB9B0\uB2E4.
      \uADF8\uB7EC\uB098 \uBE4C\uB7F0\uB4E4\uC740 \uADF8 \uB9D0\uC744 \uB4E3\uC790\uB9C8\uC790
      \uB8E8\uBBF8\uB098\uB97C \uADF9\uC9C4\uD788 \uB300\uC811\uD55C\uB2E4. \uC5F4\uD3ED\uD55C
      \uB8E8\uBBF8\uB098\uB294 \uC774\uB4E4\uC744 \uAE30\uC2B5\uD55C\uB2E4.\n\n\uBA54\uC778\uD018\uC2A4\uD2B81-1
      \uB124\uCF54\uBC0D \uC7AC\uC559 = \uD788\uC5B4\uB85C \uC911\uC5D0 \uBE4C\uB7F0\uBCF4\uB2E4
      \uBB34\uC790\uBE44\uD55C \uC874\uC7AC\uAC00 \uC788\uB2E4\uB294 \uC18C\uBB38\uC774
      \uB3CC\uACE0 \uC788\uB2E4. \uD788\uC5B4\uB85C\uB4E4\uC744 \uB9C8\uC8FC\uD55C
      \uBE4C\uB7F0\uB4E4\uC740 \uAE34\uC7A5\uD558\uC9C0\uB9CC, \uB204\uAD70\uAC00
      \uC6A9\uAE30\uB97C \uB0B4\uC5B4 \uB9DE\uC11C\uB824\uACE0 \uD558\uB294\uB370...\n\n\uBA54\uC778\uD018\uC2A4\uD2B81-2
      \uD074\uB9AC\uC5B4 = \uC18C\uB140\uAC00 \uAC81\uB3C4 \uC5C6\uC774 \uAD50\uCC28\uB85C\uB85C
      \uB2EC\uB824\uAC00 \uC624\uBE60\uC758 \uD589\uBC29\uC744 \uBB3B\uB294\uB2E4.
      \uADF8\uB54C \uBE4C\uB7F0 \uC911 \uD55C\uBA85\uC774 \uC624\uBE60\uB97C \uC54C\uACE0
      \uC788\uB2E4\uBA70 \uADF8\uB140\uB97C \uAF2C\uB4DC\uAE30\uB294\uB370, \uB204\uAC00
      \uBD10\uB3C4 \uC0AC\uAE30\uADF9\uC774\uB2E4. \uBD84\uB178\uD55C \uD788\uC5B4\uB85C\uB4E4\uC740
      \uC774\uB97C \uAC15\uD558\uAC8C \uC751\uC9D5\uD55C\uB2E4."
    "\uBE44\uACE0": "\uD2B9\uC815 \uAD6C\uC5ED \uB3C4\uB2EC \uC2DC \uD65C\uC131\uD654
      / \uBA54\uC778\uD018\uC2A4\uD2B82-1, \uBA54\uC778\uD018\uC2A4\uD2B82-3 \uD074\uB9AC\uC5B4
      \uC2DC \uC9C4\uD589 \uBD88\uAC00"
  - Field_02: 
    Field_03: 124XXXX
    "\uC81C\uBAA9": "\uBA54\uC778\uD018\uC2A4\uD2B82-2_\uACB0\uB860"
    "\uC18C\uAC1C": "\uAE30\uBCF8 = \uD788\uC5B4\uB85C\uB4E4\uC740 \uC5B4\uB5BB\uAC8C\uB4E0
      \uAE38\uC744 \uB6AB\uB294\uB2E4.\n\uC774\uC81C \uB0A8\uC740 \uAE38\uC740 \uACF5\uAD6C\uC0C1\uC5D0
      \uC788\uB294 \uAE38 \uBFD0\uC774\uB2E4.\n\n[\uD2B9\uC218 \uD50C\uB798\uADF8]\n\uBA54\uC778\uD018\uC2A4\uD2B81-1
      \uB8E8\uBBF8\uB098 \uB098\uB77D = \uB8E8\uBBF8\uB098\uC758 \uAC15\uB825\uD55C
      \uD654\uB825\uC744 \uB9DB\uBCF8 \uBE4C\uB7F0\uB4E4\uC740 \uADF8\uB140\uAC00
      \uC804\uC124\uC758 \uD751\uB9C8\uBC95\uC0AC '\uB098\uB77D'\uC784\uC744 \uD655\uC2E0\uD558\uACE0
      \uB0A9\uC791 \uC5C5\uB4DC\uB9B0\uB2E4. \uB8E8\uBBF8\uB098\uB294 \uAC15\uD558\uAC8C
      \uBD80\uC815\uD558\uC9C0\uB9CC, \uBE4C\uB7F0\uB4E4\uC740 \uC624\uD788\uB824
      \uC9C4\uC9DC\uC778 \uC774\uC720\uB77C\uACE0 \uC5EC\uAE34\uB2E4.\n\n\uBA54\uC778\uD018\uC2A4\uD2B81-1
      \uB124\uCF54\uBC0D \uC7AC\uC559 = \uBE4C\uB7F0\uB4E4\uC774 \uB0B8 \uC6A9\uAE30\uB294
      \uBB34\uCC38\uD558\uAC8C \uAEBE\uC778\uB2E4. \uB9C8\uC9C0\uB9C9\uC5D0 \uC6A9\uAE30\uB97C
      \uB0B8 \uBE4C\uB7F0\uC774 \uACB0\uACFC\uB97C \uC778\uC815\uD558\uC9C0 \uBABB\uD558\uACE0
      \uADF8\uB4E4\uC744 \uB9D0\uB9AC\uB824\uB294 \uB124\uCF54\uBC0D\uC744 \uAE30\uC2B5\uD558\uB824\uB2E4,
      \uD558\uB298\uC758 \uC7AC\uC559\uC744 \uBC1B\uB294\uB370, \uADF8\uAC83\uC744
      \uBCF8 \uBE4C\uB7F0\uB4E4\uC740 \uD63C\uBE44\uBC31\uC0B0\uD558\uC5EC \uD769\uC5B4\uC9C4\uB2E4.
      \uC2DC\uAC04\uC774 \uC9C0\uB098 \uB3C4\uC2DC\uC5D0\uC11C\uB294 \uC0AC\uBA74\uCD08\uAC00\uC5D0
      \uBAB0\uB9B0 \uD788\uC5B4\uB85C\uB4E4\uC774 \uBE4C\uB7F0\uC5D0 \uB9DE\uC11C\uAE30
      \uC704\uD574 \uC804\uC7AC\uBBF8\uBB38\uC758 \uC6B0\uC8FC\uC801 \uC874\uC7AC\uB97C
      \uD480\uC5B4\uB193\uC558\uB2E4\uBA70, \uC190\uC18D\uC744 \uB450\uC9C0 \uC54A\uB294\uB2E4\uB294
      \uC18C\uBB38\uC774 \uD37C\uC9C4\uB2E4.\n\n\uBA54\uC778\uD018\uC2A4\uD2B81-2
      \uD074\uB9AC\uC5B4 = \uC18C\uB140\uB97C \uBC97\uACA8\uBA39\uC73C\uB824\uB294
      \uAD18\uC538\uD55C \uBE4C\uB7F0\uC744 \uAD6C\uD0C0\uD558\uB294 \uD788\uC5B4\uB85C\uB4E4.
      \uADF8\uB7EC\uB098 \uC18C\uB140\uB294 \uD788\uC5B4\uB85C\uB4E4\uC744 \uC81C\uC9C0\uD55C\uB2E4.
      \uC65C\uB0D0\uBA74 \uADF8 \uBE4C\uB7F0\uC740 \uC624\uBE60\uC758 \uC9C0\uC778\uC774\uC5C8\uAE30
      \uB54C\uBB38\uC774\uB2E4. \uBBF8\uC548\uD574\uD558\uB294 \uD788\uC5B4\uB85C\uB4E4\uC744
      \uB450\uB824\uC6CC\uD558\uBA70, \uBE4C\uB7F0\uC740 \uC18C\uB140\uC758 \uC624\uBE60\uAC00
      \uBE4C\uB7F0 \uC5F0\uD569\uC73C\uB85C \uC804\uD5A5\uD588\uACE0, \uACF5\uAD6C\uC0C1\uC744
      \uACE0\uCE58\uB294 \uC77C\uC744 \uB05D\uB0B8 \uB4A4\uC5D0 \uACF5\uAD6C\uC0C1
      \uCABD \uBD84\uB9AC\uC218\uAC70\uC7A5\uC5D0 \uB9E4\uB9BD\uB418\uC5C8\uB2E4\uACE0
      \uBC1D\uD78C\uB2E4. \uC18C\uB140\uB294 \uADF8 \uB9D0\uC744 \uB4E3\uC790\uB9C8\uC790
      \uACF5\uAD6C\uC0C1\uC73C\uB85C \uC774\uB3D9\uD55C\uB2E4."
    "\uBE44\uACE0": "\uD2B9\uC815 \uAD6C\uC5ED \uB3C4\uB2EC \uC2DC \uD65C\uC131\uD654
      / \uBA54\uC778\uD018\uC2A4\uD2B82-1, \uBA54\uC778\uD018\uC2A4\uD2B82-3 \uD074\uB9AC\uC5B4
      \uC2DC \uC9C4\uD589 \uBD88\uAC00"
  - Field_02: 
    Field_03: 125XXXX
    "\uC81C\uBAA9": "\uBA54\uC778\uD018\uC2A4\uD2B82-2_\uD328\uBC30"
    "\uC18C\uAC1C": "\uBE4C\uB7F0\uC5D0\uAC8C \uD328\uBC30\uD55C \uD788\uC5B4\uB85C\uB4E4\uC744
      \uC218\uC2B5\uD558\uACE0 \uD611\uD68C\uB85C \uBCF5\uADC0\uD55C\uB2E4.\n\uD53C\uACE4\uD574\uD558\uB294
      \uAD00\uB9AC\uC790\n\n[\uD2B9\uC218 \uD50C\uB798\uADF8]\n\n\uBA54\uC778\uD018\uC2A4\uD2B81-1
      \uB8E8\uBBF8\uB098 \uB098\uB77D = \uD788\uC5B4\uB85C\uB4E4\uC774 \uD328\uBC30\uD558\uC790,
      \uBE4C\uB7F0\uB4E4\uC740 \uC5ED\uC2DC \uD5DB\uC18C\uBB38\uC774\uB77C \uCE58\uBD80\uD558\uACE0
      \uC2E0\uACBD \uC4F0\uC9C0 \uC54A\uAC8C \uB41C\uB2E4.(\uB8E8\uBBF8\uB098 \uB098\uB77D
      \uD50C\uB798\uADF8 \uBE44\uD65C\uC131\uD654)-> \uAE30\uBCF8 \uB8E8\uD2B8\uB85C
      \uBCF5\uADC0\n\n\uBA54\uC778\uD018\uC2A4\uD2B81-1 \uB124\uCF54\uBC0D \uC7AC\uC559
      = \uD788\uC5B4\uB85C\uB4E4\uC774 \uD328\uBC30\uD558\uC790, \uBE4C\uB7F0\uB4E4\uC740
      \uC5ED\uC2DC \uD5DB\uC18C\uBB38\uC774\uB77C \uCE58\uBD80\uD558\uACE0 \uC2E0\uACBD
      \uC4F0\uC9C0 \uC54A\uAC8C \uB41C\uB2E4.(\uB124\uCF54\uBC0D \uC7AC\uC559 \uD50C\uB798\uADF8
      \uBE44\uD65C\uC131\uD654)-> \uAE30\uBCF8 \uB8E8\uD2B8\uB85C \uBCF5\uADC0\n\n\uBA54\uC778\uD018\uC2A4\uD2B8
      1-2 \uD074\uB9AC\uC5B4 = \uD788\uC5B4\uB85C\uB4E4\uC774 \uD328\uBC30\uD558\uC790,
      \uC18C\uB140\uB294 \uD558\uB294 \uC218 \uC5C6\uB2E4\uBA70 \uB2E4\uC74C\uC5D0
      \uB2E4\uC2DC \uCC3E\uC544\uC624\uACA0\uB2E4\uACE0 \uD55C \uB4A4 \uD788\uC5B4\uB85C\uB4E4\uC744
      \uB04C\uACE0 \uD611\uD68C\uB85C \uB3CC\uC544\uC628\uB2E4.-> \uC18C\uB140 \uC804\uC6A9
      \uB8E8\uD2B8 \uC720\uC9C0"
    "\uBE44\uACE0": "\uD2B9\uC815 \uAD6C\uC5ED \uB3C4\uB2EC \uC2DC \uD65C\uC131\uD654
      / \uBA54\uC778\uD018\uC2A4\uD2B82-1, \uBA54\uC778\uD018\uC2A4\uD2B82-3 \uD074\uB9AC\uC5B4
      \uC2DC \uC9C4\uD589 \uBD88\uAC00"
  - Field_02: 
    Field_03: 126XXXX
    "\uC81C\uBAA9": "\uBA54\uC778\uD018\uC2A4\uD2B82-2_\uC7AC\uC804\uD22C"
    "\uC18C\uAC1C": "\uBE4C\uB7F0\uB4E4\uC740 \uD328\uBC30\uD55C \uC8FC\uC81C\uC5D0
      \uB610 \uC654\uB290\uB0D0\uBA70 \uB2EC\uB824\uB4E0\uB2E4."
    "\uBE44\uACE0": "\uD2B9\uC815 \uAD6C\uC5ED \uB3C4\uB2EC \uC2DC \uD65C\uC131\uD654
      / \uBA54\uC778\uD018\uC2A4\uD2B82-1, \uBA54\uC778\uD018\uC2A4\uD2B82-3 \uD074\uB9AC\uC5B4
      \uC2DC \uC9C4\uD589 \uBD88\uAC00"
  - Field_02: 
    Field_03: 127XXXX
    "\uC81C\uBAA9": "\uBA54\uC778\uD018\uC2A4\uD2B82-3_\uC9C4\uC785"
    "\uC18C\uAC1C": "\uC774\uC0C1\uD560 \uC815\uB3C4\uB85C \uACBD\uBE44\uAC00 \uC801\uC740
      \uBE4C\uB7F0 \uC804\uC9C4\uAE30\uC9C0\uB97C \uACF5\uACA9\uD558\uB824\uB358
      \uD788\uC5B4\uB85C\uB4E4\uC740 \uC5ED\uC73C\uB85C \uBE4C\uB7F0\uB4E4\uC5D0\uAC8C
      \uD3EC\uC704\uB2F9\uD55C\uB2E4.\n\uADF8\uB4E4\uC740 UMT\uC5D0 \uC785\uB2E8\uD558\uAE30
      \uC704\uD574 \uD788\uC5B4\uB85C \uC2E4\uC801\uC744 \uC313\uACA0\uB2E4\uBA70,
      \uADF8\uB4E4\uC744 \uACF5\uACA9\uD55C\uB2E4.\n\n\n[\uD2B9\uC218 \uD50C\uB798\uADF8]\n\uBA54\uC778\uD018\uC2A4\uD2B81-1
      \uB8E8\uBBF8\uB098 \uB098\uB77D = \uC57D\uD0C8\uAFBC\uB4E4\uC744 \uACF5\uACA9\uD55C
      \uAC8C \uADF8\uB4E4\uC784\uC744 \uC54C\uC544\uBCF4\uACE0 \uADC0\uC5EC\uC6B4
      \uD6C4\uBC30\uB97C \uAC74\uB4DC\uB838\uB2E4\uBA70 \uACF5\uACA9\uD55C\uB2E4.\n\uBA54\uC778\uD018\uC2A4\uD2B81-1
      \uB124\uCF54\uBC0D \uC7AC\uC559 = \uC9C4\uC815\uD55C \uBE4C\uB7F0\uC740 \uC124\uB839
      \uBB34\uC790\uBE44\uD55C \uC815\uC758\uAC00 \uB4E4\uC774\uB2E5\uCCD0\uB3C4
      \uB5B3\uB5B3\uD558\uAC8C \uB9C8\uC8FC\uD558\uB294 \uBC95\uC774\uB77C\uBA70
      \uACF5\uACA9\uD55C\uB2E4.\n\uBA54\uC778\uD018\uC2A4\uD2B81-2 \uD074\uB9AC\uC5B4
      = \uC18C\uB140\uB294 \uBE4C\uB7F0\uB4E4\uC774 \uC624\uBE60\uC640 \uCE5C\uD558\uAC8C
      \uC9C0\uB0B4\uB358 \uC0AC\uB78C\uB4E4\uC784\uC744 \uC54C\uC544\uBCF8\uB2E4.
      \uC774\uB294 \uADF8\uB4E4\uC774 \uD568\uAED8 \uBE4C\uB7F0 \uC5F0\uD569\uC5D0
      \uC785\uB2E8\uD558\uC790\uACE0 \uD798\uC744 \uBAA8\uC740 UMT \uC9C0\uB9DD\uC0DD\uC774\uC5C8\uAE30
      \uB54C\uBB38. \uB2E4\uB9CC \uADF8\uB4E4\uC740 \uBE4C\uB7F0 \uC5F0\uD569\uC5D0
      \uC785\uB2E8\uD588\uC9C0\uB9CC \uC720\uC77C\uD558\uAC8C \uC624\uBE60\uB9CC
      \uBABB\uD55C \uAC83. \uACB0\uAD6D UMT \uC9C0\uB9DD\uC0DD\uB4E4\uC740 \uCC28\uB9C8
      \uC18C\uB140\uB97C \uAC74\uB4DC\uB9B4 \uC218 \uC5C6\uC5B4 \uD1F4\uAC01\uD558\uACE0
      \uAE30\uC9C0\uC5D0 \uB0A8\uC740 \uC801\uC740 \uBB34\uB9AC\uB9CC \uD788\uC5B4\uB85C\uB97C
      \uC0C1\uB300\uD558\uAC8C \uB41C\uB2E4."
    "\uBE44\uACE0": "\uD2B9\uC815 \uAD6C\uC5ED \uB3C4\uB2EC \uC2DC \uD65C\uC131\uD654
      / \uBA54\uC778\uD018\uC2A4\uD2B82-1, \uBA54\uC778\uD018\uC2A4\uD2B82-2 \uD074\uB9AC\uC5B4
      \uC2DC \uC9C4\uD589 \uBD88\uAC00"
  - Field_02: 
    Field_03: 128XXXX
    "\uC81C\uBAA9": "\uBA54\uC778\uD018\uC2A4\uD2B82-3_\uACB0\uB860"
    "\uC18C\uAC1C": "\uD3FC \uC7A1\uACE0 \uB098\uD0C0\uB098\uC11C \uB9E5 \uBE60\uC9C0\uAC8C
      \uD328\uD558\uACE0 \uB3C4\uB9DD\uCE5C \uBE4C\uB7F0\uB4E4.\n\uACB0\uAD6D \uBB50\uC600\uB358
      \uAC78\uAE4C.\n\uC544\uBB34\uD2BC \uAE38\uC740 \uB6AB\uB838\uB2E4.\n\n[\uD2B9\uC218
      \uD50C\uB798\uADF8]\n\uBA54\uC778\uD018\uC2A4\uD2B8 1-1 \uB8E8\uBBF8\uB098
      \uB098\uB77D = \uB8E8\uBBF8\uB098\uC758 \uD654\uB825\uC744 \uB9DB\uBCF8 \uBE4C\uB7F0\uB4E4\uC774
      \uB300\uC120\uBC30\uB2D8\uC744 \uBAB0\uB77C\uBD48\uC5C8\uB2E4\uBA70 \uC808\uD558\uACE0
      \uBB3C\uB7EC\uC120\uB2E4. \n\uBA54\uC778\uD018\uC2A4\uD2B8 1-1 \uB124\uCF54\uBC0D
      \uC7AC\uC559 = \uBE4C\uB7F0\uB4E4\uC740 \uC808\uB300 \uAD74\uD558\uC9C0 \uC54A\uACA0\uB2E4\uACE0
      \uC758\uC9C0\uB85C \uC77C\uC5B4\uC11C\uC9C0\uB9CC, \uADF8 \uC758\uC9C0\uB294
      \uB124\uCF54\uBC0D\uC758 \uC758\uB3C4\uCE58 \uC54A\uC740 \uC190\uAE38 \uC544\uB798
      \uCCA0\uC800\uD788 \uC720\uB9B0\uB2F9\uD55C\uB2E4. \uBE4C\uB7F0\uC5D0\uAC8C
      \uBC00\uCCD0\uC9C4 \uB124\uCF54\uBC0D\uC774 \uBC14\uB2E5\uC744 \uC9DA\uC790,
      \uC2F1\uD06C\uD640\uC774 \uC0DD\uAE30\uBA70 UMT \uC9C0\uB9DD\uC0DD\uB4E4\uC740
      \uD754\uC801\uB3C4 \uC5C6\uC774 \uC0AC\uB77C\uC84C\uB2E4.\n\uBA54\uC778\uD018\uC2A4\uD2B8
      1-2 \uD074\uB9AC\uC5B4 = \uC804\uD22C\uAC00 \uB05D\uB098\uACE0 \uBCF4\uB2C8
      UMT \uC9C0\uB9DD\uC0DD\uB4E4\uC774 \uB0A8\uAE34 \uD3B8\uC9C0\uC9C0\uAC00 \uC788\uB2E4.
      \uAC70\uAE30\uC5D4 \uC624\uBE60\uAC00 \uC81C\uBC1C\uB85C \uAC78\uC5B4\uC640
      \uBE4C\uB7F0\uC774 \uB418\uC5C8\uC73C\uBA70, \uD2B9\uC720\uC758 \uC790\uBED1\uC73C\uB85C
      \uACF5\uAD6C\uC0C1\uC758 \uBE4C\uB7F0 \uB9AC\uB354\uB97C \uC5F4\uBC1B\uAC8C
      \uD574 \uACF5\uAD6C\uC0C1 \uC218\uB9AC\uB97C \uB9C8\uCE58\uC790\uB9C8\uC790
      \uADFC\uCC98 \uBD84\uB9AC\uC218\uAC70\uC7A5\uC5D0\uC11C \uBC84\uB824\uC84C\uB2E4\uACE0
      \uD55C\uB2E4. \uC18C\uB140\uB294 \uC369\uC5B4\uBE60\uC9C4 \uC624\uBE60\uB97C
      \uAD6C\uD558\uAE30 \uC704\uD574 \uC6C0\uC9C1\uC778\uB2E4."
    "\uBE44\uACE0": "\uD2B9\uC815 \uAD6C\uC5ED \uB3C4\uB2EC \uC2DC \uD65C\uC131\uD654
      / \uBA54\uC778\uD018\uC2A4\uD2B82-1, \uBA54\uC778\uD018\uC2A4\uD2B82-2 \uD074\uB9AC\uC5B4
      \uC2DC \uC9C4\uD589 \uBD88\uAC00"
  - Field_02: 
    Field_03: 129XXXX
    "\uC81C\uBAA9": "\uBA54\uC778\uD018\uC2A4\uD2B82-3_\uD328\uBC30"
    "\uC18C\uAC1C": "\uBE4C\uB7F0\uC5D0\uAC8C \uD328\uBC30\uD55C \uD788\uC5B4\uB85C\uB4E4\uC744
      \uC218\uC2B5\uD558\uACE0 \uD611\uD68C\uB85C \uBCF5\uADC0\uD55C\uB2E4.\n\uD53C\uACE4\uD574\uD558\uB294
      \uAD00\uB9AC\uC790\n\n[\uD2B9\uC218 \uD50C\uB798\uADF8]\n\uBA54\uC778\uD018\uC2A4\uD2B81-1
      \uB8E8\uBBF8\uB098 \uB098\uB77D = \uC5ED\uC2DC \uB098\uB77D\uC740 \uC5C6\uC5C8\uB2E4\uBA70
      \uC548\uC2EC\uD558\uACE0 \uB3CC\uC544\uAC04\uB2E4.(\uB8E8\uBBF8\uB098 \uB098\uB77D
      \uD50C\uB798\uADF8 \uBE44\uD65C\uC131\uD654)-> \uAE30\uBCF8 \uB8E8\uD2B8\uB85C
      \uBCF5\uADC0\n\uBA54\uC778\uD018\uC2A4\uD2B81-1 \uB124\uCF54\uBC0D \uC7AC\uC559
      = UMT\uB294 \uAC70\uB300\uD55C \uC7AC\uC559\uC744 \uBAB0\uC544\uB0C8\uB2E4\uBA70
      \uAE30\uBED0\uD558\uBA74\uC11C \uD788\uC5B4\uB85C\uB4E4\uC744 \uC81C\uC555\uD558\uB294
      \uAC83\uB3C4 \uAE4C\uBA39\uACE0 \uB3CC\uC544\uAC04\uB2E4.(\uB124\uCF54\uBC0D
      \uC7AC\uC559 \uD50C\uB798\uADF8 \uBE44\uD65C\uC131\uD654)-> \uAE30\uBCF8 \uB8E8\uD2B8\uB85C
      \uBCF5\uADC0\n\uBA54\uC778\uD018\uC2A4\uD2B8 1-2 \uD074\uB9AC\uC5B4 = \uD788\uC5B4\uB85C\uB4E4\uC774
      \uD328\uBC30\uD558\uC790, \uC18C\uB140\uB294 \uD558\uB294 \uC218 \uC5C6\uB2E4\uBA70
      \uB2E4\uC74C\uC5D0 \uB2E4\uC2DC \uCC3E\uC544\uC624\uACA0\uB2E4\uACE0 \uD55C
      \uB4A4 \uD788\uC5B4\uB85C\uB4E4\uC744 \uB04C\uACE0 \uD611\uD68C\uB85C \uB3CC\uC544\uC628\uB2E4.->
      \uC18C\uB140 \uC804\uC6A9 \uB8E8\uD2B8 \uC720\uC9C0"
    "\uBE44\uACE0": "\uD2B9\uC815 \uAD6C\uC5ED \uB3C4\uB2EC \uC2DC \uD65C\uC131\uD654
      / \uBA54\uC778\uD018\uC2A4\uD2B82-1, \uBA54\uC778\uD018\uC2A4\uD2B82-2 \uD074\uB9AC\uC5B4
      \uC2DC \uC9C4\uD589 \uBD88\uAC00"
  - Field_02: 
    Field_03: 130XXXX
    "\uC81C\uBAA9": "\uBA54\uC778\uD018\uC2A4\uD2B82-3_\uC7AC\uC804\uD22C"
    "\uC18C\uAC1C": "\uBE4C\uB7F0\uB4E4\uC740 \uD328\uBC30\uD55C \uC8FC\uC81C\uC5D0
      \uB610 \uC654\uB290\uB0D0\uBA70 \uB2EC\uB824\uB4E0\uB2E4."
    "\uBE44\uACE0": "\uD2B9\uC815 \uAD6C\uC5ED \uB3C4\uB2EC \uC2DC \uD65C\uC131\uD654
      / \uBA54\uC778\uD018\uC2A4\uD2B82-1, \uBA54\uC778\uD018\uC2A4\uD2B82-2 \uD074\uB9AC\uC5B4
      \uC2DC \uC9C4\uD589 \uBD88\uAC00"
  - Field_02: 
    Field_03: 103XXXX
    "\uC81C\uBAA9": "\uBA54\uC778\uD018\uC2A4\uD2B83_\uC9C4\uC785"
    "\uC18C\uAC1C": "\uD788\uC5B4\uB85C\uB4E4\uC774 \uBE4C\uB7F0 \uC5F0\uD569\uC774
      \uC810\uB839\uD55C \uACF5\uAD6C\uC0C1\uC5D0 \uC9C4\uC785\uD55C\uB2E4.\n\uACF5\uAD6C\uC0C1\uC758
      \uC704\uCE58\uB294 \uBA54\uC778\uD018\uC2A4\uD2B81\uC5D0\uC11C \uD655\uBCF4\uD558\uBA70,
      \uBA54\uC778\uD018\uC2A4\uD2B82\uC5D0\uC11C\uB294 \uC120\uD0DD\uD55C \uBD84\uAE30\uC5D0
      \uB530\uB77C \uC778\uC9C8 \uC815\uBCF4\uC758 \uD655\uBCF4 \uC5EC\uBD80\uAC00
      \uB2EC\uB77C\uC9C4\uB2E4.\n\n[\uC18C\uB140 \uB3D9\uD589]\n\uACF5\uAD6C\uC0C1
      \uC9C4\uC785 \uC804\uC5D0 \uBD84\uB9AC\uC218\uAC70\uC7A5\uC5D0\uC11C \uC624\uBE60\uB97C
      \uB9CC\uB09C\uB2E4. \uC778\uC9C8 \uC815\uBCF4\uB97C \uBAB0\uB790\uB2E4\uBA74
      \uC624\uBE60\uC758 \uC124\uBA85\uC774 \uB05D\uB09C \uB4A4 \uC778\uC9C8 \uC815\uBCF4
      \uD50C\uB798\uADF8\uB97C \uD68D\uB4DD\uD55C\uB2E4. \uC774\uBBF8 \uC54C\uACE0
      \uC788\uC5C8\uB2E4\uBA74 \uC624\uBE60\uC758 \uC815\uBCF4\uAC00 \uC4F8\uBAA8\uC5C6\uC5B4\uC9C0\uACE0
      \uC18C\uB140\uC758 \uD540\uC794 \uC7A5\uBA74\uC73C\uB85C \uC774\uC5B4\uC9C4\uB2E4.\n\n[\uC9C4\uC785
      \uC120\uD0DD]\n\uC778\uC9C8 \uC815\uBCF4\uB97C \uC54C\uBA74 \uC815\uBA74 \uB3CC\uD30C\uC640
      \uC778\uC9C8 \uC6B0\uC120 \uAD6C\uCD9C\uC744 \uC120\uD0DD\uD55C\uB2E4. \uBAA8\uB974\uBA74
      \uC815\uBA74 \uB3CC\uD30C\uC640 \uC7A0\uC785\uC744 \uC120\uD0DD\uD55C\uB2E4.\n\uAC1C\uD3B8
      \uC804 \uC6D0\uBB38\uC758 \uC815\uBA74 \uB3CC\uD30C, \uB8E8\uBBF8\uB098 \uC7A0\uC785\xB7\uD3ED\uC8FC,
      \uC800\uC2A4\uD2F0\uC2A4\uC640 \uBE14\uB799\uBD88\uB9BF\uC758 \uC5F0\uAE30
      \uBC0F \uC774\uB97C \uC5FF\uBCF4\uB294 \uBE4C\uB7F0, I.P\uAC00 \uB0AE\uC744
      \uB54C\uC758 \uC778\uC9C8 \uBC18\uC751\uC744 \uC720\uC9C0\uD55C\uB2E4.\n\uC815\uBA74
      \uB3CC\uD30C\uB294 \uC778\uC9C8 \uCCB4\uB825 75%, \uAE30\uC2B5 \uC911 \uB8E8\uBBF8\uB098
      \uD3ED\uC8FC\uB294 50%, \uC778\uC9C8 \uAD6C\uCD9C \uC911 \uBC1C\uAC01\uC740
      100%\uC5D0\uC11C \uC804\uD22C\uB97C \uC2DC\uC791\uD55C\uB2E4."
    "\uBE44\uACE0": "\uC778\uC9C8 \uC815\uBCF4 \uC720\uBB34\uC5D0 \uB530\uB978 \uC120\uD0DD\uC9C0
      \uC5F0\uACB0 / \uC804\uD22C\uBCC4 \uC778\uC9C8 \uCD08\uAE30 \uCCB4\uB825 \uBC0F
      \uAC31\uC2E0\uB41C \uACBD\uB85C \uD50C\uB798\uADF8 \uBC18\uC601"
  - Field_02: 
    Field_03: 104XXXX
    "\uC81C\uBAA9": "\uBA54\uC778\uD018\uC2A4\uD2B83_\uD074\uB9AC\uC5B4"
    "\uC18C\uAC1C": "\uACF5\uAD6C\uC0C1 \uC810\uB839\uC804 \uC2B9\uB9AC \uD6C4 \uC778\uC9C8
      \uBD80\uC0C1\uC790 \uC218\uC5D0 \uB530\uB77C \uAC1C\uD3B8 \uC804 \uACB0\uACFC
      \uB300\uC0AC\uAC00 \uC774\uC5B4\uC9C4\uB2E4.\n\uC778\uC9C8 3\uBA85 \uBD80\uC0C1,
      1~2\uBA85 \uBD80\uC0C1, \uC804\uC6D0 \uBB34\uC0AC \uACB0\uACFC\uB97C \uC720\uC9C0\uD558\uBA70,
      \uC778\uC9C8 \uC6B0\uC120 \uAD6C\uCD9C \uB8E8\uD2B8\uC5D0\uC11C\uB294 \uC800\uC2A4\uD2F0\uC2A4\uC640
      \uBE14\uB799\uBD88\uB9BF\uC758 \uC5F0\uAE30 \uD6C4\uC77C\uB2F4\uC774 \uCD94\uAC00\uB41C\uB2E4.\n\uC804\uD22C
      \uD328\uBC30\uB294 \uBCC4\uB3C4\uC758 \uD328\uBC30\xB7\uC7AC\uC804\uD22C \uC774\uBCA4\uD2B8\uB85C
      \uC5F0\uACB0\uD55C\uB2E4."
    "\uBE44\uACE0": "\uAC70\uC810 \uC810\uB839 \uBC0F \uC778\uC9C8 \uAD6C\uCD9C \uACB0\uACFC
      \uC774\uBCA4\uD2B8"
  - Field_02: 
    Field_03: 131XXXX
    "\uC81C\uBAA9": "\uBA54\uC778\uD018\uC2A4\uD2B83_\uD328\uBC30"
    "\uC18C\uAC1C": "\uACF5\uAD6C\uC0C1 \uC810\uB839\uC804\uC5D0 \uD328\uBC30\uD55C
      \uD30C\uD2F0\uAC00 \uC120\uD0DD\uD55C \uC9C4\uC785 \uBC29\uC2DD\uC758 \uD1F4\uB85C\uB85C
      \uCCA0\uC218\uD55C\uB2E4.\n\uC815\uBA74 \uB3CC\uD30C\xB7\uC7A0\uC785\xB7\uC778\uC9C8
      \uBCF4\uD638 \uB8E8\uD2B8\uBCC4 \uC2E4\uD328 \uC6D0\uC778\uC744 \uD655\uC778\uD558\uACE0
      \uAC19\uC740 \uBC29\uC2DD\uC758 \uC7AC\uACF5\uACA9\uC744 \uC900\uBE44\uD55C\uB2E4."
    "\uBE44\uACE0": "\uAC70\uC810 \uC810\uB839\uC804 \uD328\uBC30 \uC774\uBCA4\uD2B8"
  - Field_02: 
    Field_03: 132XXXX
    "\uC81C\uBAA9": "\uBA54\uC778\uD018\uC2A4\uD2B83_\uC7AC\uC804\uD22C"
    "\uC18C\uAC1C": "\uC774\uC804 \uC804\uD22C\uC5D0\uC11C \uD655\uC778\uD55C \uACBD\uBE44
      \uBC30\uCE58\uB97C \uBC18\uC601\uD574 \uACF5\uAD6C\uC0C1\uC5D0 \uC7AC\uC9C4\uC785\uD55C\uB2E4.\n\uC815\uBA74
      \uB3CC\uD30C\uB294 BE003, \uC7A0\uC785\uC740 BE004, \uC778\uC9C8 \uBCF4\uD638\uB294
      BE002\uB97C \uB2E4\uC2DC \uD638\uCD9C\uD558\uACE0 \uC804\uD22C \uC885\uB8CC
      \uB4A4 \uB3D9\uC77C\uD55C \uACB0\uACFC \uBD84\uAE30\uB85C \uBCF5\uADC0\uD55C\uB2E4."
    "\uBE44\uACE0": "\uAC70\uC810 \uC810\uB839\uC804 \uC7AC\uB3C4\uC804 \uC774\uBCA4\uD2B8"
  - Field_02: "\uC11C\uBE0C \uD018\uC2A4\uD2B8 1"
    Field_03: 105XXXX
    "\uC81C\uBAA9": "\uC11C\uBE0C\uD018\uC2A4\uD2B81 \uC9C4\uC785"
    "\uC18C\uAC1C": "\uD55C \uACE8\uBAA9\uC5D0\uC11C \uC2DC\uBBFC\uC774 \uBE4C\uB7F0\uC5D0\uAC8C
      \uCD94\uACA9\uB2F9\uD55C\uB2E4. \uC800\uC2A4\uD2F0\uC2A4\uAC00 \uACA9\uBD84\uD574
      \uBE4C\uB7F0\uC744 \uB9C9\uC544\uC11C\uACE0, \uBE4C\uB7F0\uC740 \uC2DC\uAC04\uC774
      \uC5C6\uB2E4\uBA70 \uC2F8\uC6C0\uC744 \uAC74\uB2E4."
    "\uBE44\uACE0": 
  - Field_02: 
    Field_03: 106XXXX
    "\uC81C\uBAA9": "\uC11C\uBE0C\uD018\uC2A4\uD2B81_\uD074\uB9AC\uC5B4"
    "\uC18C\uAC1C": "\uD328\uD558\uACE0\uB3C4 \uC5B5\uC6B8\uD574\uD558\uB294 \uBE4C\uB7F0.
      \uC54C\uACE0 \uBCF4\uB2C8 \uC2DC\uBBFC\uC774 \uBE4C\uB7F0\uC758 \uBCF4\uAE09\uD488\uC744
      \uD6D4\uCE58\uACE0 \uC790\uAE30 \uAC83\uC778 \uC591 \uD589\uC138\uD55C \uAC83\uC774\uB2E4.\n\n\uC2DC\uBBFC\uC774
      \uC801\uBC18\uD558\uC7A5\uC73C\uB85C \uBE4C\uB7F0\uC5D0\uAC8C \uBB3C\uAC74\uC744
      \uB3CC\uB824\uC918\uC11C \uC560\uAFCE\uC740 \uC2DC\uBBFC\uC744 \uB2E4\uCE58\uAC8C
      \uD560 \uAC70\uB0D0\uACE0 \uC800\uC2A4\uD2F0\uC2A4\uB97C \uBAB0\uC544\uBD99\uC774\uC790,
      \uADF8\uC640 \uCE5C\uD55C \uBE14\uB799\uBD88\uB9BF\uC740 \uC740\uC5F0\uC911
      \uBD88\uCF8C\uAC10\uC744 \uB4DC\uB7EC\uB0B8\uB2E4.\n\n[\uC120\uD0DD\uC9C0]\n1.
      \uBE14\uB799\uBD88\uB9BF\uC5D0\uAC8C \uB9E1\uAE34\uB2E4.: \uBE14\uB799\uBD88\uB9BF\uC740
      \uC2DC\uBBFC\uC744 \uB54C\uB824 \uAE30\uC808\uC2DC\uD0A4\uACE0 \uBB3C\uAC74\uC744
      \uBE4C\uB7F0\uC5D0\uAC8C \uB3CC\uB824\uC900\uB2E4. \uBE4C\uB7F0\uC740 \uACE0\uB9D9\uB2E4\uBA70
      \uC18C\uC815\uC758 \uBCF4\uC0C1\uC744 \uC8FC\uACE0 \uC0AC\uB77C\uC9C4\uB2E4.
      \uB300\uC2E0 \uD3ED\uD589\uB2F9\uD55C \uC2DC\uBBFC\uC740 \uC774\uB97C \uC81C\uBCF4\uD558\uC5EC
      \uD788\uC5B4\uB85C\uB4E4\uC758 \uBA85\uC131\uC774 \uD06C\uAC8C \uB5A8\uC5B4\uC9C4\uB2E4.\n2.
      \uBE4C\uB7F0\uC5D0\uAC8C\uC11C \uBB3C\uAC74\uC744 \uC555\uC218\uD55C\uB2E4.:
      \uBE4C\uB7F0\uC740 \uD788\uC5B4\uB85C\uB3C4 \uB2E4 \uD55C\uD1B5\uC18D\uC774\uB77C\uACE0
      \uB208\uBB3C\uC744 \uD6D4\uCE58\uBA70 \uC0AC\uB77C\uC9C0\uACE0, \uC2DC\uBBFC\uC740
      \uB2F9\uC5F0\uD55C \uC591 \uBB3C\uAC74\uC744 \uAC00\uC9C0\uACE0 \uAC00\uB824
      \uD55C\uB2E4. \uADF8\uB7EC\uB098 \uAD00\uB9AC\uC790\uB294 \uBC95\uC744 \uB4E4\uC774\uBC00\uBA70
      \uBE4C\uB7F0\uC758 \uC0AC\uC720\uBB3C\uC740 \uD788\uC5B4\uB85C \uD611\uD68C\uC758
      \uAD00\uB9AC\uD558\uC5D0 \uC788\uACE0, \uC774\uB97C \uAC00\uC838\uAC00\uB294
      \uAC74 \uC808\uB3C4\uB77C \uBAB0\uC544\uBD99\uC5EC \uADF8\uB97C \uCC98\uBC8C\uD55C\uB2E4.
      \uD611\uD68C\uB294 \uD604\uC7A5 \uD574\uACB0\uC5D0 \uB300\uD55C \uC18C\uC815\uC758
      \uBCF4\uC0C1\uC744 \uC9C0\uAE09\uD55C\uB2E4."
    "\uBE44\uACE0": 
  - Field_02: 
    Field_03: 107XXXX
    "\uC81C\uBAA9": "\uC11C\uBE0C\uD018\uC2A4\uD2B81_\uD328\uBC30"
    "\uC18C\uAC1C": "\uBE4C\uB7F0\uC5D0\uAC8C \uD788\uC5B4\uB85C\uB4E4\uC774 \uBB34\uCC38\uD788
      \uD328\uD558\uC790 \uC2DC\uBBFC\uC740 \uD754\uC801\uB3C4 \uC5C6\uC774 \uC0AC\uB77C\uC9C0\uACE0,
      \uBE4C\uB7F0\uC740 \uAE30\uC808\uD55C \uD788\uC5B4\uB85C\uB4E4\uC744 \uB0B4\uBC84\uB824
      \uB454 \uCC44 \uC2DC\uBBFC\uC744 \uCAD3\uC544\uAC04\uB2E4. \uAD00\uB9AC\uC790\uB294
      \uD788\uC5B4\uB85C\uB4E4\uC744 \uD611\uD68C\uB85C \uBCF5\uADC0\uC2DC\uD0A8\uB2E4."
    "\uBE44\uACE0": 
  - Field_02: 
    Field_03: 133XXXX
    "\uC81C\uBAA9": "\uC11C\uBE0C\uD018\uC2A4\uD2B81_\uC7AC\uC804\uD22C"
    "\uC18C\uAC1C": "\uB3CC\uACE0 \uB3CC\uC544 \uC2DC\uBBFC\uACFC \uBE4C\uB7F0, \uD788\uC5B4\uB85C\uB4E4\uC740
      \uAC19\uC740 \uACF3\uC5D0\uC11C \uB2E4\uC2DC \uB9C8\uC8FC\uD55C\uB2E4. \uBE4C\uB7F0\uACFC
      \uC7AC\uC804\uD22C\uAC00 \uBC1C\uC0DD\uD55C\uB2E4."
    "\uBE44\uACE0": 
  - Field_02: "\uC11C\uBE0C \uD018\uC2A4\uD2B8 2"
    Field_03: 108XXXX
    "\uC81C\uBAA9": "\uC11C\uBE0C\uD018\uC2A4\uD2B82-1 \uC9C4\uC785"
    "\uC18C\uAC1C": "\uD3B8\uC758\uC810 \uC9C4\uC0C1\uB9CC \uACE8\uB77C \uACF5\uACA9\uD558\uB294
      \uBE4C\uB7F0\uC758 \uC18C\uBB38\uC744 \uB4E3\uB294\uB2E4. \uC601\uC218\uC99D\xB7CCTV
      \uBD84\uC11D, \uC9C1\uC6D0 \uD0D0\uBB38, \uC800\uC2A4\uD2F0\uC2A4\uC758 \uC9C4\uC0C1
      \uC5F0\uAE30 \uC911 \uD558\uB098\uB85C \uB2E8\uC11C\uB97C \uD655\uBCF4\uD558\uACE0
      \uC804\uC9C1 \uD3B8\uC758\uC810 \uC9C1\uC6D0\uC778 \uBC94\uC778\uC758 \uC740\uC2E0\uCC98\uB97C
      \uCC3E\uC544\uB0B8\uB2E4."
    "\uBE44\uACE0": 
  - Field_02: 
    Field_03: 109XXXX
    "\uC81C\uBAA9": "\uC11C\uBE0C\uD018\uC2A4\uD2B82-2 \uC9C4\uC785"
    "\uC18C\uAC1C": "\uD3D0\uC810\uD55C \uD3B8\uC758\uC810\uC5D0\uC11C \uBE4C\uB7F0\uACFC
      \uB9C8\uC8FC\uCE5C\uB2E4. \uC7A5\uC2DC\uAC04 \uB2E8\uB3C5 \uADFC\uBB34\uC640
      \uACE0\uAC1D \uD3ED\uC5B8, \uBD80\uB2F9 \uD574\uACE0, \uD788\uC5B4\uB85C \uBA74\uC811
      \uD0C8\uB77D\uC73C\uB85C \uC774\uC5B4\uC9C4 \uACFC\uAC70\uB97C \uB4E3\uACE0
      \uD68C\uC720\uD558\uB824 \uD558\uC9C0\uB9CC, \uD788\uC5B4\uB85C\uB4E4\uC774
      \uD138\uC5B4\uB193\uC740 \uD3B8\uC758\uC810 \uBBFC\uD3D0 \uACBD\uD5D8\uC774
      \uC6EC\uB9CC\uD55C \uBE4C\uB7F0\uBCF4\uB2E4 \uC2EC\uAC01\uD558\uB2E4\uB294
      \uC0AC\uC2E4\uC5D0 \uBE4C\uB7F0\uC774 \uACA9\uBD84\uD574 \uC804\uD22C\uAC00
      \uBC8C\uC5B4\uC9C4\uB2E4."
    "\uBE44\uACE0": 
  - Field_02: 
    Field_03: 110XXXX
    "\uC81C\uBAA9": "\uC11C\uBE0C\uD018\uC2A4\uD2B82-2_\uD074\uB9AC\uC5B4"
    "\uC18C\uAC1C": "\uD3B8\uC758\uC810 \uBE4C\uB7F0\uC744 \uC81C\uC555\uD55C\uB2E4.
      \uC800\uC2A4\uD2F0\uC2A4\uB294 \uD788\uC5B4\uB85C\uC758 \uC790\uAE0D\uC2EC\uC740
      \uBD84\uB178\uB97C \uD718\uB450\uB974\uB294 \uAC83\uC774 \uC544\uB2C8\uB77C
      \uD798\uC774 \uC788\uC5B4\uB3C4 \uB118\uC9C0 \uC54A\uC744 \uC120\uC744 \uC9C0\uD0A4\uB294
      \uB370\uC11C \uC0DD\uAE34\uB2E4\uACE0 \uAC00\uB974\uCE5C\uB2E4. \uC810\uC8FC\uB294
      \uC548\uC804 \uADDC\uC815\uC744 \uBCF4\uC644\uD558\uACE0 \uADF8\uB97C \uC218\uC2B5
      \uC9C1\uC6D0\uC73C\uB85C \uB2E4\uC2DC \uBC1B\uC544\uB4E4\uC778\uB2E4."
    "\uBE44\uACE0": 
  - Field_02: 
    Field_03: 135XXXX
    "\uC81C\uBAA9": "\uC11C\uBE0C\uD018\uC2A4\uD2B82-2_\uD328\uBC30"
    "\uC18C\uAC1C": "\uD3ED\uC8FC\uD55C \uD3B8\uC758\uC810 \uBE4C\uB7F0\uC5D0\uAC8C
      \uBC00\uB9AC\uC790 \uBE14\uB799\uBD88\uB9BF\uC774 \uC18C\uD654\uAE30\uB97C
      \uD130\uB728\uB824 \uC5F0\uB9C9\uC744 \uB9CC\uB4E4\uACE0, \uB124\uCF54\uBC0D\uACFC
      \uB8E8\uBBF8\uB098\uAC00 \uC4F0\uB7EC\uC9C4 \uB3D9\uB8CC\uB4E4\uC744 \uD68C\uC218\uD55C\uB2E4.
      \uAD00\uB9AC\uC790\uB294 \uD788\uC5B4\uB85C\uB4E4\uC744 \uD611\uD68C\uB85C
      \uBCF5\uADC0\uC2DC\uCF1C \uC7AC\uC804\uD22C\uB97C \uC900\uBE44\uD55C\uB2E4."
    "\uBE44\uACE0": 
  - Field_02: 
    Field_03: 136XXXX
    "\uC81C\uBAA9": "\uC11C\uBE0C\uD018\uC2A4\uD2B82-2_\uC7AC\uC804\uD22C"
    "\uC18C\uAC1C": "\uC815\uBE44\uB97C \uB9C8\uCE5C \uD788\uC5B4\uB85C\uB4E4\uC774
      \uD3D0\uC810\uD55C \uD3B8\uC758\uC810\uC744 \uB2E4\uC2DC \uCC3E\uC544\uAC04\uB2E4.
      \uD3B8\uC758\uC810 \uBE4C\uB7F0\uC740 \uC7AC\uBC29\uBB38 \uACE0\uAC1D\uC774\uB77C\uBA70
      \uC774\uB4E4\uC744 \uB2E4\uC2DC SSS\uAE09 \uC9C4\uC0C1\uC73C\uB85C \uBD84\uB958\uD558\uACE0
      \uC7AC\uACA9\uB3CC\uD55C\uB2E4."
    "\uBE44\uACE0": 
