    EnemySkill3_MultiTargetCount: 0
    EnemySkill3Value: 0
    EnemySkill3SubValue: 0
    UnitAI: "(\uB9E4 \uD134)\n\uACF5\uACA9 \uD589\uB3D9\uACFC \uC778\uC9C8 \uC704\uD611
      \uD589\uB3D9 \uC911 \uBB34\uC5C7\uC744 \uC218\uD589\uD560\uC9C0 \uD310\uC815\n{TotalHostageAggro}
      \uAC12\uC5D0 \uBE44\uB840\uD558\uC5EC \uC778\uC9C8 \uC704\uD611 \uD589\uB3D9
      \uC218\uD589 \uBE44\uC911 \uC99D\uAC00\n\uC790\uC138\uD55C \uB0B4\uC6A9\uC740
      1\uAD6C\uC5ED \uACF5\uAD6C\uC0C1 \uC778\uC9C8\uADF9_\uC138\uBD80 \uAD6C\uD604
      \uAE30\uD68D \uBB38\uC11C 3. \uBE4C\uB7F0 \uD589\uB3D9 \uD310\uC815 \uCC38\uACE0\n\n//\uC778\uC9C8
      \uC704\uD611\n\uC6B0\uC120 \uC21C\uC704\n1. \uAC00\uC7A5 {HostageAggro} \uAC12\uC774
      \uB192\uC740 \uC778\uC9C8\uC744 \uD45C\uC801\uC73C\uB85C \uC0BC\uB294\uB2E4.\n2.
      {HostageAggro}\uAC12\uC774 \uB3D9\uC77C\uD560 \uACBD\uC6B0 \uD0C0\uC77C \uBC88\uD638
      \uC624\uB984\uCC28\uC21C\uC73C\uB85C \uC120\uC815\uD55C\uB2E4.\n3. \uB300\uC0C1\uC73C\uB85C
      \uC120\uC815\uD560 \uC778\uC9C8\uC774 \uC5C6\uC73C\uBA74 '\uC6D0\uAC70\uB9AC
      \uC0AC\uACA9' \uD589\uB3D9\uC73C\uB85C \uC804\uD658\uD55C\uB2E4.\n\n//\uACF5\uACA9
      \uD589\uB3D9 / \uACF5\uACA9 \uD589\uB3D9 \uD310\uC815 \uC2DC\uC758 \uD589\uB3D9
      \uC120\uD0DD \uB85C\uC9C1\uC740 \uAE30\uC874 \uC804\uD22C\uB85C\uC9C1\uACFC
      \uB3D9\uC77C\n'\uB300\uC2E0 \uB9DE\uAE30'\n- \uC544\uAD70 \uC720\uB2DB \uC911,
      \uCCB4\uB825 30% \uBBF8\uB9CC \uC720\uB2DB\uC774 1\uBA85 \uC774\uC0C1 \uC788\uB294
      \uACBD\uC6B0, '\uB300\uC2E0 \uB9DE\uAE30' \uC2E4\uD589\n- \uC544\uB2CC \uACBD\uC6B0
      \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC720\uB2DB\uC5D0\uAC8C '\uBC29\uD328 \uCE58\uAE30'
      \uC2E4\uD589"
