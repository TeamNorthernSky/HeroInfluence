    EnemySkill3_Name: "\uC808\uB9DD\uC758 \uAD74\uB808"
    EnemySkill3_Description: "(\uD604 \uD14C\uC774\uBE14 \uC0C1 \uAD6C\uD604\uC774
      \uD798\uB4DC\uBBC0\uB85C \uBCC4\uB3C4 \uC11C\uC220)\n\n\uC2DC\uC804\uC790 \uC9C4\uC601\uC758
      \uC804\uC5F4(1,2,3 \uD0C0\uC77C)\uC5D0 \uC808\uB9DD\uC758 \uAD74\uB801\uC1E0
      \uC18C\uD658\n\uC808\uB9DD\uC758 \uAD74\uB801\uC1E0\uB294 \uC720\uB2DB\uC73C\uB85C
      \uCDE8\uAE09\uB418\uBA70 \uACF5\uACA9 \uB300\uC0C1\uC774 \uB418\uC5B4 \uD53C\uD574\uB97C
      \uC785\uC744 \uC218 \uC788\uC74C.\n\n\uC808\uB9DD\uC758 \uAD74\uB801\uC1E0
      \uC18C\uD658 \uD6C4 \uD55C \uB77C\uC6B4\uB4DC\uAC00 \uC9C0\uB098 \uBCF8\uC778
      \uD134\uC774 \uB3CC\uC544\uC624\uBA74 \uD574\uB2F9 \uC720\uB2DB\uC774 \uC18D\uD55C
      \uD589\uC758 \uD788\uC5B4\uB85C \uC9C4\uC601\uC73C\uB85C \uB3CC\uC9C4\uD574
      \uD589 \uC804\uCCB4\uC5D0 {EnemySkill3Value} \uB9CC\uD07C \uAD11\uC5ED\uD53C\uD574"
    EnemySkill3Effect: 0
    EnemySkill3Range: 0
    EnemySkill3RangeLine: 0
    EnemySkill3Target: 0
    EnemySkill3MultiTarget: 
    EnemySkill3_MultiTargetType: 0
    EnemySkill3_MultiTargetCount: 0
    EnemySkill3Value: 2.3
    EnemySkill3SubValue: 2.3
    UnitAI: "1~2 \uD398\uC774\uC988\n- \uC774 \uC720\uB2DB\uC740 YuliaReservedSkillSource
      \uB2E8\uC77C \uC608\uC57D\uAC12\uC744 \uD655\uC778\uD55C\uB2E4.\n- YuliaReservedSkillSource\uC5D0
      \uC720\uD6A8\uD55C \uC99D\uD3ED\uAE30 \uAC1C\uCCB4\uAC00 \uC788\uC73C\uBA74,
      \uD574\uB2F9 \uC99D\uD3ED\uAE30\uAC00 \uC81C\uACF5\uD558\uB294 \uC2A4\uD0AC\uC744
      \uC2DC\uC804\uD55C\uB2E4.\n- \uC608\uC57D\uAC12\uC774 \uC5C6\uAC70\uB098, \uC728\uB9AC\uC544
      \uD134 \uC804\uC5D0 \uC608\uC57D \uC99D\uD3ED\uAE30\uAC00 \uD30C\uAD34\uB418\uC5B4
      \uC720\uD6A8\uD558\uC9C0 \uC54A\uC73C\uBA74 \uAE30\uBCF8 \uC2A4\uD0AC '\uC808\uB9DD\uC758
      \uAD74\uB808'\uB97C \uC2DC\uC804\uD55C\uB2E4.\n- \uC2A4\uD0AC \uC2DC\uC804
      \uD6C4 YuliaReservedSkillSource\uB97C \uCD08\uAE30\uD654\uD55C\uB2E4.\n\n3
      \uD398\uC774\uC988\n- \uCCB4\uB825 50% \uC774\uD558 \uC2DC '\uC728\uB9AC\uC544\uB97C
      \uAC00\uB454 \uC7A5\uB9C9'\uC73C\uB85C \uB300\uCCB4\uB41C\uB2E4.\n\n\u203B
      \uBCF8 \uD14C\uC774\uBE14\uC758 UnitAI\uB294 \uAC04\uB7B5 \uADDC\uCE59\uB9CC
      \uC815\uB9AC\uD55C\uB2E4. \uC138\uBD80 \uAD6C\uD604 \uADDC\uCE59\uC740 \u300C4\uAD6C\uC5ED
      \uC728\uB9AC\uC544 \uBCF4\uC2A4\uC804_\uC138\uBD80 \uAD6C\uD604 \uAE30\uD68D\u300D
      \uBB38\uC11C\uB97C \uAE30\uC900\uC73C\uB85C \uD55C\uB2E4."
